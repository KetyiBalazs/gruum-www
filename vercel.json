{
  "redirects": [
    { "source": "/home", "destination": "/coming-soon", "permanent": false },
    { "source": "/home/", "destination": "/coming-soon", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/array/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    { "source": "/coming-soon", "destination": "/coming-soon.html" },
    { "source": "/coming-soon/", "destination": "/coming-soon.html" },
    { "source": "/coming-soon-1", "destination": "/coming-soon-1.html" },
    { "source": "/coming-soon-1/", "destination": "/coming-soon-1.html" },
    { "source": "/coming-soon-2", "destination": "/coming-soon-2.html" },
    { "source": "/coming-soon-2/", "destination": "/coming-soon-2.html" }
  ]
}
